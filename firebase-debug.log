[debug] [2026-09-04T11:18:57.311Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/sketchly-44c83/rulesets {"name":"projects/sketchly-44c83/rulesets/c0f2c0fc-5f19-4060-b5eb-545475a0501e","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── Helper functions ──\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return request.auth.uid == uid;\n    }\n\n    // ── Users ──\n    // Users can read/write only their own profile document.\n    match /users/{userId} {\n      allow read: if isSignedIn();\n      allow write: if isSignedIn() && isOwner(userId);\n    }\n\n    // ── Scribbles (SRS §7) ──\n    // A user can read a Scribble if they are the sender OR a recipient.\n    // A user can only create a Scribble where senderId matches their UID.\n    // Scribbles cannot be edited after creation (BR-1).\n    match /scribbles/{scribbleId} {\n      allow read: if isSignedIn() &&\n        (request.auth.uid == resource.data.senderId ||\n         request.auth.uid in resource.data.recipientIds);\n\n      allow create: if isSignedIn() &&\n        request.auth.uid == request.resource.data.senderId &&\n        request.resource.data.recipientIds.size() > 0 &&\n        request.resource.data.recipientIds.size() <= 10; // SRS BR-3\n\n      // No update/delete for sent Scribbles in MVP (BR-1, BR-2 handled app-side)\n      allow update, delete: if false;\n    }\n\n    // ── Reactions (SRS §7, FR-7) ──\n    // Document ID convention: \"{scribbleId}_{userId}\" — enforces one-per-user.\n    // A user can only write their own reaction.\n    // Read: reactor (own reaction) or the Scribble's sender (to see reactions).\n    match /reactions/{reactionId} {\n      allow read: if isSignedIn() &&\n        (request.auth.uid == resource.data.userId ||\n         request.auth.uid ==\n           get(/databases/$(database)/documents/scribbles/$(resource.data.scribbleId)).data.senderId);\n\n      allow create, update: if isSignedIn() &&\n        request.auth.uid == request.resource.data.userId &&\n        request.resource.data.emoji is string &&\n        request.resource.data.emoji.size() > 0;\n\n      allow delete: if isSignedIn() &&\n        request.auth.uid == resource.data.userId;\n    }\n\n    // ── Contact Relationships ──\n    // Users can only read/write their own contact entries.\n    match /contacts/{userId}/relationships/{contactId} {\n      allow read, write: if isSignedIn() && isOwner(userId);\n    }\n\n    // ── Email OTPs ──\n    // Written and read exclusively by Cloud Functions (Admin SDK).\n    // Deny all client access to prevent enumeration or bypass attacks.\n    match /emailOtps/{email} {\n      allow read, write: if false;\n    }\n\n    // ── Rate Limits ──\n    // Written and read exclusively by Cloud Functions (Admin SDK).\n    match /rateLimits/{docId} {\n      allow read, write: if false;\n    }\n\n    // ── Follow Requests ──\n    // A user can create a follow request where fromUserId == their UID.\n    // A user can read requests that involve them (as sender or recipient).\n    // Only the recipient can update the status (accept/decline).\n    // Sender can delete their own pending request (cancel).\n    match /followRequests/{requestId} {\n      allow read: if isSignedIn() &&\n        (request.auth.uid == resource.data.fromUserId ||\n         request.auth.uid == resource.data.toUserId);\n\n      allow create: if isSignedIn() &&\n        request.auth.uid == request.resource.data.fromUserId &&\n        request.resource.data.status == \"pending\";\n\n      allow update: if isSignedIn() &&\n        request.auth.uid == resource.data.toUserId &&\n        request.resource.data.status in [\"accepted\", \"declined\"];\n\n      allow delete: if isSignedIn() &&\n        request.auth.uid == resource.data.fromUserId &&\n        resource.data.status == \"pending\";\n    }\n\n    // ── Connections ──\n    // Readable by either connected user. Written only by Cloud Functions.\n    match /connections/{connectionId} {\n      allow read: if isSignedIn() &&\n        (request.auth.uid == resource.data.userAId ||\n         request.auth.uid == resource.data.userBId);\n      allow write: if false; // Admin SDK only (onFollowRequestAccept)\n    }\n\n    // ── Suggested Contacts (contact sync results) ──\n    // Users can only read their own suggestedContacts sub-collection.\n    // Writes are performed exclusively by the matchContactsByHash Cloud Function.\n    match /users/{userId}/suggestedContacts/{contactId} {\n      allow read: if isSignedIn() && isOwner(userId);\n      allow write: if false; // Admin SDK only\n    }\n\n    // Deny everything else by default.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-04T11:18:57.184047Z","metadata":{"services":["cloud.firestore"]}}
