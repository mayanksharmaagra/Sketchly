<?xml version="1.0" encoding="utf-8"?>
<!--
    AppWidget provider metadata for SketchlyWidget.
    minWidth/minHeight correspond to 2×2 cells on a standard launcher grid.
    targetCellWidth/targetCellHeight are the recommended sizes from Android 12+.
    updatePeriodMillis=0 because updates are fully push-driven via WorkManager + FCM.
    resizeMode allows both horizontal and vertical resize (handles 4×2 variant).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="110dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
