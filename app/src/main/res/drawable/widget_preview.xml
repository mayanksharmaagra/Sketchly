<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget preview shown in the launcher's widget picker.
    A simple rounded rectangle with the app's paper-ivory background
    and a pencil icon, matching the widget's visual identity.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F4F1DE" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#E8E0CC" />
</shape>
