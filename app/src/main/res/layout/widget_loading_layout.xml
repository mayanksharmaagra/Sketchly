<?xml version="1.0" encoding="utf-8"?>
<!--
    Initial layout shown by the launcher in the widget picker and while
    Glance is loading its Compose content for the first time.
    Must be a classic RemoteViews-compatible layout (no Compose).
    Background colour matches SketchlyWidget's PaperIvory (#F4F1DE).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1DE">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="✏️"
        android:textSize="32sp" />

</FrameLayout>
