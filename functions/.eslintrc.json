{
  "env": {
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "google"
  ],
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-restricted-globals": ["error", "name", "length"],
    "prefer-arrow-callback": "error",
    "quotes": ["error", "double", {"avoidEscape": true}],
    "max-len": ["warn", {"code": 150}],
    "indent": ["error", 2],
    "object-curly-spacing": ["error", "never"]
  }
}
